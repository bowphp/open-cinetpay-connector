{
    "name": "bowphp/open-cinetpay-connector",
    "description": "CinetPay connector for Bow PHP Framework",
    "keywords": [
        "framework",
        "bow",
        "bowphp",
        "php",
        "cinetpay",
        "payment"
    ],
    "type": "project",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/bowphp/open-cinetpay-connector/issues",
        "source": "https://github.com/bowphp/open-cinetpay-connector"
    },
    "require": {
        "php": "^8.1",
        "bowphp/cqrs": "^1.0",
        "bowphp/framework": "^5.2",
        "bowphp/meta-manager": "^1.0",
        "bowphp/policier": "^3.0",
        "prewk/result": "^3.1",
        "ramsey/uuid": "^4.7",
        "ext-pdo": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "monolog/monolog": "^3.0",
        "squizlabs/php_codesniffer": "3.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "config/helpers.php"
        ]
    },
    "scripts": {
        "lint": "phpcbf --standard=psr12 --tab-width=4 app tests config routes",
        "test": "phpunit --configuration phpunit.xml",
        "post-root-package-install": [
            "@php -r \"file_exists('.env.json') || copy('.env.example.json', '.env.json');\""
        ],
        "post-create-project-cmd": [
            "@php bow generate:key"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "suggest": {
        "bowphp/tintin": "For using tintin template engine",
        "papac/bow-blade": "For using Blade template engine"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
